{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "artifact_kind": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "required_guard_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_paid_operations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "delivery_requires_approval": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "objective",
    "artifact_kind",
    "policy_version",
    "required_guard_ids",
    "max_attempts"
  ]
}
