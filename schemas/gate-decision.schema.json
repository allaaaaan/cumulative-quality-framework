{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "rework",
        "human_review",
        "blocked"
      ]
    },
    "evaluation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "approver_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "decision_id",
    "contract_id",
    "artifact_sha256",
    "policy_version",
    "verdict",
    "evaluation_ids",
    "reason",
    "decided_at"
  ]
}
